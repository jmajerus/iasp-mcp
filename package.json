{
  "name": "iasp-mcp",
  "version": "0.1.0",
  "description": "Informative Authoring Semantics Profile (IASP) MCP server: compositional authoring intent vocabulary (following terminology-mcp), Markdown validation, and Pandoc/Ghost rendering",
  "scripts": {
    "iasp": "tsx --env-file-if-exists=.env src/cli.ts",
    "terms": "tsx --env-file-if-exists=.env src/cli.ts terms",
    "demo": "tsx --env-file-if-exists=.env src/cli.ts demo",
    "serve": "tsx --env-file-if-exists=.env src/cli.ts serve",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "jose": "^6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
