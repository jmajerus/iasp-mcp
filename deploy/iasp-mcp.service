[Unit]
Description=iasp-mcp MCP server (Streamable HTTP), web reference, and Pandoc/Ghost rendering pipeline
After=network-online.target
Wants=network-online.target

[Service]
User=iasp
Group=iasp
EnvironmentFile=/etc/iasp-mcp/env
WorkingDirectory=/opt/iasp-mcp/current
ExecStart=/usr/bin/node /opt/iasp-mcp/current/dist/cli.js serve
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/iasp-mcp

[Install]
WantedBy=multi-user.target
