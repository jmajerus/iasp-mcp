#!/bin/bash
# iasp-mcp's CLI on its server, for the authoring login: `iasp-mcp status`, `iasp-mcp terms`,
# `iasp-mcp demo`, and so on, from any folder. It runs the CLI as the iasp user with the server's
# settings, as the services do; sudo asks for authoring's password. npm run deploy installs it in
# /usr/local/bin. It runs in the current release, so give files it writes a path the iasp user can
# write, such as /tmp or /var/lib/iasp-mcp/renders.
set -euo pipefail
if [ "$(id -un)" != iasp ]; then exec sudo runuser -u iasp -- "$0" "$@"; fi
set -a; . /etc/iasp-mcp/env; set +a
cd /opt/iasp-mcp/current
exec node dist/cli.js "$@"
