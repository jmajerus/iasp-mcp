# SQLite database path (default: data/iasp.db)
# IASP_DB=data/iasp.db

# HTTP listener (default: 0.0.0.0:8000)
# IASP_HOST=0.0.0.0
# IASP_PORT=8000

# Optional, for `npm run deploy`: the deploy account's SSH password.
# AUTHORING_DEPLOY_PASSWORD=

# Optional, override the deploy target (default: authoring@iasp-mcp.localdomain)
# IASP_DEPLOY_HOST=authoring@iasp-mcp.localdomain

# Optional, override the server queried by tools/iasp-status.mjs (default: http://iasp-mcp.localdomain:8000)
# IASP_STATUS_URL=http://iasp-mcp.localdomain:8000

# terminology-mcp endpoint (default: http://terminology-mcp.localdomain:8000; set to "off" to disable polling)
# TERMINOLOGY_BASE=http://terminology-mcp.localdomain:8000

# Poll terminology-mcp every minute while serving (on | off; default: on)
# IASP_TERMS_SYNC=on

# Optional Cloudflare Access team domain for non-LAN requests
# ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
